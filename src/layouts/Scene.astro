---
// A full-screen 3D page: the canvas, a loading veil, the header and the caption.
// `theme` is "dark" (the tower at dusk) or "light" (the case in the stone hall).
interface Props { title: string; description: string; theme: 'dark' | 'light'; here: 'tower' | 'case'; loading: string }
const { title, description, theme, here, loading } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en" data-theme={theme}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="color-scheme" content={theme}>
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..600;1,6..96,400&family=Cormorant+Garamond:ital,wght@1,300;1,400&family=Manrope:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
  <div class="loading" id="loading">{loading}</div>
  <canvas id="gl" aria-label={description}></canvas>
  <div class="scrim"></div>
  <header>
    <a class="mk" href={base}>Cinem<i>arium</i></a>
    <nav aria-label="Layouts">
      <a href={base} aria-current={here === 'tower' ? 'page' : undefined}>The Tower</a>
      <a href={`${base}series/severance/`} aria-current={here === 'case' ? 'page' : undefined}>The Case</a>
      <button class="snd" id="snd" aria-pressed="false" title="Room tone">Sound off</button>
    </nav>
  </header>
  <slot />
  <script>
    import { roomTone } from '../scene/sound';
    const b = document.getElementById('snd')!, tone = roomTone('office');
    b.addEventListener('click', () => { tone.playing ? tone.stop() : tone.start(); b.textContent = tone.playing ? 'Sound on' : 'Sound off'; b.setAttribute('aria-pressed', String(tone.playing)); });
  </script>
  <style is:global>
    :root{
      --display:'Bodoni Moda',ui-serif,Didot,Georgia,serif; --italic:'Cormorant Garamond',ui-serif,Georgia,serif; --sans:'Manrope',ui-sans-serif,system-ui,sans-serif;
    }
    [data-theme=dark]{ --bg:#070707; --fg:#EFE8DC; --dim:rgba(239,232,220,.56); --hair:rgba(239,232,220,.16); --brass:#D2AE6C; --veil:4,6,10; color-scheme:dark }
    [data-theme=light]{ --bg:#e9dfd0; --fg:#2a2118; --dim:rgba(42,33,24,.62); --hair:rgba(42,33,24,.2); --brass:#8a6a32; --veil:233,223,208; color-scheme:light }
    *{box-sizing:border-box}
    html,body{height:100%;margin:0;background:var(--bg);color:var(--fg);overflow:hidden;font-family:var(--sans)}
    canvas{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none}
    .scrim{position:fixed;inset:0;pointer-events:none;z-index:1;background:linear-gradient(90deg,rgba(var(--veil),.5) 0,rgba(var(--veil),.18) 22%,transparent 34%),linear-gradient(0deg,rgba(var(--veil),.45) 0,transparent 18%)}
    header{position:fixed;inset:0 0 auto 0;display:flex;justify-content:space-between;align-items:baseline;padding:calc(24px + env(safe-area-inset-top,0px)) clamp(16px,3vw,44px) 0;z-index:3;font-size:12.5px;letter-spacing:.04em}
    .mk{font-family:var(--display);font-size:22px;color:var(--fg);text-decoration:none}
    .mk i{font-family:var(--italic);font-weight:300}
    nav{display:flex;gap:26px}
    nav a{color:var(--dim);text-decoration:none}
    nav a[aria-current=page]{color:var(--fg)}
    .snd{background:none;border:0;color:var(--dim);font:inherit;letter-spacing:inherit;cursor:pointer;padding:0}
    .snd[aria-pressed=true]{color:var(--fg)}
    nav a:focus-visible,button:focus-visible,.cap a:focus-visible{outline:1px solid var(--brass);outline-offset:3px}
    .cap{position:fixed;left:clamp(16px,3vw,44px);top:50%;transform:translateY(-42%);z-index:2;width:min(460px,calc(100vw - 32px))}
    .cap .k{font-size:10.5px;letter-spacing:.3em;text-transform:uppercase;color:var(--brass)}
    .cap h1{font-family:var(--display);font-weight:400;font-size:clamp(40px,4.4vw,64px);line-height:1.02;margin:10px 0 8px}
    .cap .sc{font-family:var(--italic);font-style:italic;font-size:20px;color:var(--dim)}
    .cap a{display:inline-block;margin-top:18px;color:var(--fg);text-decoration:none;font-size:12px;letter-spacing:.2em;text-transform:uppercase;border-bottom:1px solid var(--brass);padding-bottom:3px}
    .fade{transition:opacity .45s,transform .55s}
    .fade.out{opacity:0}
    .loading{position:fixed;inset:0;display:grid;place-items:center;z-index:5;font-family:var(--italic);font-style:italic;font-size:22px;color:var(--dim);background:var(--bg);transition:opacity .8s}
    .loading.done{opacity:0;pointer-events:none}
    .loading.error{font-family:var(--sans);font-style:normal;font-size:14px;padding:24px;text-align:center;line-height:1.6}
    @media (max-width:760px){
      header{flex-direction:column;gap:10px}
      .cap{top:auto;transform:none;bottom:calc(40px + env(safe-area-inset-bottom,0px))}
      .scrim{background:linear-gradient(0deg,rgba(var(--veil),.88) 0,rgba(var(--veil),.4) 30%,transparent 48%)}
      .cap h1{font-size:36px}
    }
    @media (prefers-reduced-motion:reduce){ .fade{transition:none} }
  </style>
</body>
</html>
